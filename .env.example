# ─── CaptionGrab environment ─────────────────────────────────────────────
# Copy to `.env` for local development. Never commit real secrets.

# Base URL of the CaptionGrab Worker API.
#  • Local dev with the Vite proxy (recommended): leave EMPTY — `/api/*`
#    is proxied to `http://127.0.0.1:8787` (see vite.config.ts).
#  • Local dev without proxy, or pointing at a deployed Worker:
#    VITE_API_URL=https://captiongrab-api.<your-subdomain>.workers.dev
VITE_API_URL=

# ─── Vercel (production) ────────────────────────────────────────────────
# Set in the Vercel dashboard (Project → Settings → Environment Variables):
#   API_WORKER_URL=https://captiongrab-api.<your-subdomain>.workers.dev
# Vercel rewrites same-origin `/api/*` to the Worker (see vercel.json),
# so the frontend needs no VITE_* variables in production at all.
